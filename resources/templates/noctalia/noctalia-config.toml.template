[[control_center.shortcuts]]
type = "wifi"

[[control_center.shortcuts]]
type = "bluetooth"

[[control_center.shortcuts]]
type = "notification"

[[control_center.shortcuts]]
type = "dark_mode"

[[control_center.shortcuts]]
type = "audio"

[[control_center.shortcuts]]
type = "mic_mute"

[widget.control-center]
glyph = "settings-2"

[widget.clock]
anchor = true
color = "primary"
font_family = "@mono@"
font_weight = 800
format = "{:%I:%M %p}"
scale = 1.4
vertical_format = "{:%I\\n%M %p}"

[widget.date]
color = "secondary"
format = "{:%a %b %d }"
scale = 1.1

[widget.tray]
drawer = true
drawer_columns = 5
pinned = ["1password"]

[widget.workspaces]
empty_color = "primary"
focused_color = "secondary"
occupied_color = "primary"
pill_scale = 0.85
show_labels = false

[widget.weather]
color = "secondary"
scale = 1.1