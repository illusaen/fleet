[accessibility]
ui_scale               = 1.1

[shell]
font_family            = "@sans@"
time_format            = "{:%I:%M %p}" # default shell UI time format
polkit_agent           = true
password_style         = "default"    # default | random
settings_show_advanced = true         # show advanced settings by default in Settings
app_icon_colorize      = true         # recolor application icons across the shell
app_icon_color         = "surface"    # ColorSpec role or #hex when colorize is enabled

[shell.panel]
transparency_mode      = "glass"      # solid | soft | glass; controls floating-panel opacity and card translucency
clipboard_placement    = "attached"   # attached | floating

[shell.launcher]
categories             = false        # show category filters in the launcher
show_app_origin_indicator = false     # show package origin indicators on application results
app_grid               = true         # show app icon grid view when results are apps only

[wallpaper]
fill_mode           = "center"                  # center | crop | fit | stretch | repeat | span
transition          = ["fade", "wipe", "disc", "stripes", "zoom", "honeycomb"]
directory           = "@imageDirectory@"        # empty = XDG Pictures directory
directory_light     = "@imageDirectory@/light"  # optional day-mode directory
directory_dark      = "@imageDirectory@/dark"   # optional night-mode directory

[wallpaper.default]
path = "@image@"                      # optional initial/default wallpaper path

[wallpaper.automation]
enabled                    = true
interval_seconds           = 1000     # seconds between changes
recursive                  = false    # include subdirectories when picking random wallpapers

[theme]
mode   = "auto"                     # dark | light | auto
builtin = "Rosé Pine"               # Ayu | Catppuccin | Dracula | Eldritch | Gruvbox |
                                    # Kanagawa | Noctalia | Nord | Rosé Pine | Tokyo-Night
pure_black_dark = true              # anchor dark surfaces to true black (OLED); applies to
                                    # every palette source, not just wallpaper-generated ones

[backdrop]
blur_intensity = 0.4
enabled = true

[notification]
background_opacity = 0.8
offset_x = 0
offset_y = 64
scale    = 1.2 
position = "bottom_center"

[osd]
offset_x = 0
offset_y = 64
scale    = 1.2 
background_opacity = 0.8
position = "bottom_center"

[lockscreen]
monitors = ["@main@"]

[calendar]
enabled = true

[weather]
enabled = true
unit    = "fahrenheit"

[audio]
enable_sounds = true                # master toggle for UI feedback sounds
sound_volume = 0.25                 # 0.0 - 1.0

[location]
address = "@location@"

[idle.behavior.screen-off]
action = "screen_off"
enabled = true
timeout = 600

[bar.default]
position = "left"
thickness = 48
background_opacity = 0.9
margin_ends = 720
margin_edge = 8
padding = 16
widget_spacing = 16
reserve_space = false
start = ["session", "workspaces"]
center = [ "date", "clock", "weather" ]
end = ["tray", "clipboard", "control-center"]

[bar.default.monitor.@secondary@]
enabled = false

[desktop_widgets]
schema_version = 2
widget_order = [
    "clock_main",
    "cpu_temp",
    "switcher_hdmi",
    "switcher_dp",
    "gpu_usage",
    "cpu_usage",
    "gpu_temp",
    "ram_usage",
    "cpu_label",
    "gpu_label",
    "ram_label"
]

[desktop_widgets.grid]
cell_size = 8
major_interval = 4
visible = true

[desktop_widgets.widget.clock_main]
box_height = 160.0
box_width = 288.0
cx = 620.0
cy = 1680.0
output = "@secondary@"
placement_height = 1920.0
placement_width = 1080.0
type = "clock"

[desktop_widgets.widget.clock_main.settings]
background = false
color = "on_surface"
font_family = "@mono@"
format = "{:%H:%M}"

[desktop_widgets.widget.cpu_temp]
