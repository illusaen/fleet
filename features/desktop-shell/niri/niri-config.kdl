"window-rule"  {
  "clip-to-geometry" true
  "geometry-corner-radius" 12
  "popups"  {
    "background-effect"  {
      "blur" true
    }
    "opacity" 0.92
  }
  "tiled-state" true
}
"window-rule"  {
  "match" "is-active"=false
  "background-effect"  {
    "blur" true
  }
  "opacity" 0.9
}
"window-rule"  {
  "match" "is-floating"=true
  "background-effect"  {
    "blur" true
    "xray" false
  }
  "opacity" 0.96
}
"window-rule"  {
  "match" "app-id"="^ndrop-alacritty$"
  "background-effect"  {
    "blur" true
  }
  "default-column-width"  {
    "proportion" 0.4
  }
  "default-floating-position" "relative-to"="top" "x"=0 "y"=0
  "default-window-height"  {
    "proportion" 0.5
  }
  "opacity" 0.8
  "open-floating" true
}
"window-rule"  {
  "match" "title"="^(.*)(o|O|s|S)(pen|ave) (f|F|a|a)(ile|s)(.*)"
  "match" "app-id"="org.pulseaudio.pavucontrol"
  "match" "app-id"="^(.*)blueman-manager(.*)$"
  "match" "app-id"="xdg-desktop-portal-gtk"
  "match" "app-id"="xdg-desktop-portal-gnome"
  "match" "app-id"="org.gnome.Nautilus"
  "match" "app-id"="dev.noctalia.Noctalia.Settings"
  "default-column-width"  {
    "proportion" 0.3
  }
  "default-window-height"  {
    "proportion" 0.4
  }
  "open-floating" true
}
"window-rule"  {
  "match" "app-id"="alacritty"
  "match" "app-id"="google-chrome"
  "match" "app-id"="firefox"
  "default-column-display" "tabbed"
}
"window-rule"  {
  "match" "app-id"="mpv"
  "match" "app-id"="com.github.th-ch.youtube-music"
  "default-column-width"  {
    "proportion" 1.0
  }
  "default-window-height"  {
    "proportion" 0.5
  }
  "open-on-workspace" "music"
}
"window-rule"  {
  "match" "app-id"="code"
  "match" "app-id"="google-chrome"
  "match" "app-id"="firefox"
  "open-on-workspace" "code"
}
"window-rule"  {
  "match" "at-startup"=true
  "open-focused" false
}
"window-rule"  {
  "match" "app-id"="1password" "at-startup"=true
  "open-focused" true
  "open-on-workspace" "code"
}
"window-rule"  {
  "match" "app-id"="firefox" "title"="Picture-in-Picture"
  "open-floating" true
}
"window-rule"  {
  "match" "app-id"="vesktop"
  "match" "app-id"="discord"
  "match" "app-id"="Element"
  "match" "app-id"="org.telegram.desktop"
  "open-on-workspace" "chat"
}
"window-rule"  {
  "match" "title"="Viking Rise Steam"
  "match" "app-id"="steam.*"
  "open-on-workspace" "gaming"
}
"window-rule"  {
  "match" "title"="Viking Rise Steam"
  "min-width" 4192
}
"window-rule"  {
  "match" "app-id"="steam" "title"="^notificationtoasts_\\d+_desktop$"
  "default-floating-position" "relative-to"="bottom-right" "x"=2 "y"=2
  "open-focused" false
}
"layer-rule"  {
  "match" "namespace"="^noctalia-backdrop$"
  "place-within-backdrop" true
}
"layer-rule"  {
  "match" "namespace"="^noctalia-bar-"
  "background-effect"  {
    "blur" false
  }
}

"animations"  {
  "config-notification-open-close"  {
    "spring" "damping-ratio"=0.6 "epsilon"=0.001 "stiffness"=1000
  }
  "exit-confirmation-open-close"  {
    "spring" "damping-ratio"=0.6 "epsilon"=0.01 "stiffness"=500
  }
  "horizontal-view-movement"  {
    "spring" "damping-ratio"=1.0 "epsilon"=0.0001 "stiffness"=800
  }
  "overview-open-close"  {
    "spring" "damping-ratio"=1.0 "epsilon"=0.0001 "stiffness"=800
  }
  "recent-windows-close"  {
    "spring" "damping-ratio"=1.0 "epsilon"=0.001 "stiffness"=800
  }
  "screenshot-ui-open"  {
    "curve" "ease-out-quad"
    "duration-ms" 200
  }
  "window-close"  {
    "curve" "ease-out-quad"
    "duration-ms" 150
  }
  "window-movement"  {
    "spring" "damping-ratio"=0.8 "epsilon"=0.0001 "stiffness"=1000
  }
  "window-open"  {
    "curve" "ease-out-expo"
    "duration-ms" 150
  }
  "window-resize"  {
    "spring" "damping-ratio"=1.0 "epsilon"=0.0001 "stiffness"=800
  }
  "workspace-switch"  {
    "spring" "damping-ratio"=0.65 "epsilon"=0.0001 "stiffness"=1000
  }
}

"binds"  {
  "Alt+Shift+4"  {
    "screenshot" 
  }
  "Alt+Shift+T" "hotkey-overlay-title"="Toggle Terminal" {
    "spawn-sh" "ndrop --app-id '^ndrop-alacritty$' --name alacritty -- alacritty --class ndrop-alacritty"
  }
  "Ctrl+Alt+Delete"  {
    "quit" 
  }
  "Ctrl+Space" "hotkey-overlay-title"="Launcher" {
    "spawn-sh" "noctalia msg panel-toggle launcher"
  }
  "Mod+Alt+Shift+Left"  {
    "move-workspace-to-monitor-left" 
  }
  "Mod+Alt+Shift+Right"  {
    "move-workspace-to-monitor-right" 
  }
  "Mod+Alt+T" "hotkey-overlay-title"="Theme Selector" {
    "spawn" "theme-select"
  }
  "Mod+BracketLeft"  {
    "consume-or-expel-window-left" 
  }
  "Mod+BracketRight"  {
    "consume-or-expel-window-right" 
  }
  "Mod+C"  {
    "center-column" 
  }
  "Mod+Comma"  {
    "consume-window-into-column" 
  }
  "Mod+Ctrl+B" "hotkey-overlay-title"="Brightness +" {
    "spawn-sh" "monitor-brightness up"
  }
  "Mod+Ctrl+C"  {
    "center-visible-columns" 
  }
  "Mod+Ctrl+Down"  {
    "move-window-down-or-to-workspace-down" 
  }
  "Mod+Ctrl+End"  {
    "move-column-to-last" 
  }
  "Mod+Ctrl+Home"  {
    "move-column-to-first" 
  }
  "Mod+Ctrl+Left"  {
    "move-column-left" 
  }
  "Mod+Ctrl+R"  {
    "reset-window-height" 
  }
  "Mod+Ctrl+Right"  {
    "move-column-right" 
  }
  "Mod+Ctrl+Shift+B" "hotkey-overlay-title"="Brightness -" {
    "spawn-sh" "monitor-brightness down"
  }
  "Mod+Ctrl+Shift+Left"  {
    "move-column-to-monitor-left" 
  }
  "Mod+Ctrl+Shift+R"  {
    "switch-preset-window-height" 
  }
  "Mod+Ctrl+Shift+Right"  {
    "move-column-to-monitor-right" 
  }
  "Mod+Ctrl+Shift+WheelScrollDown" "cooldown-ms"=150 {
    "move-column-right" 
  }
  "Mod+Ctrl+Shift+WheelScrollUp" "cooldown-ms"=150 {
    "move-column-left" 
  }
  "Mod+Ctrl+Space" "hotkey-overlay-title"="Power Menu" {
    "spawn-sh" "noctalia msg panel-toggle session"
  }
  "Mod+Ctrl+Up"  {
    "move-window-up-or-to-workspace-up" 
  }
  "Mod+Ctrl+WheelScrollDown" "cooldown-ms"=150 {
    "move-column-to-workspace-down" 
  }
  "Mod+Ctrl+WheelScrollUp" "cooldown-ms"=150 {
    "move-column-to-workspace-up" 
  }
  "Mod+Down" "hotkey-overlay-title"="Focus Window/Workspace ↓" {
    "focus-window-or-workspace-down" 
  }
  "Mod+End"  {
    "focus-column-last" 
  }
  "Mod+Escape" "allow-inhibiting"=false {
    "toggle-keyboard-shortcuts-inhibit" 
  }
  "Mod+F"  {
    "maximize-column" 
  }
  "Mod+Home"  {
    "focus-column-first" 
  }
  "Mod+Left"  {
    "focus-column-left" 
  }
  "Mod+O" "repeat"=false {
    "toggle-overview" 
  }
  "Mod+Period"  {
    "expel-window-from-column" 
  }
  "Mod+Q" "repeat"=false {
    "close-window" 
  }
  "Mod+R"  {
    "switch-preset-column-width" 
  }
  "Mod+Right"  {
    "focus-column-right" 
  }
  "Mod+S" "hotkey-overlay-title"="Notification Center" {
    "spawn-sh" "noctalia msg panel-toggle control-center"
  }
  "Mod+Shift+F"  {
    "fullscreen-window" 
  }
  "Mod+Shift+L" "hotkey-overlay-title"="Lock Screen" {
    "spawn" "swaylock"
  }
  "Mod+Shift+Left"  {
    "focus-monitor-left" 
  }
  "Mod+Shift+P"  {
    "power-off-monitors" 
  }
  "Mod+Shift+R"  {
    "switch-preset-column-width-back" 
  }
  "Mod+Shift+Right"  {
    "focus-monitor-right" 
  }
  "Mod+Shift+Slash"  {
    "show-hotkey-overlay" 
  }
  "Mod+Shift+V"  {
    "switch-focus-between-floating-and-tiling" 
  }
  "Mod+Shift+WheelScrollDown" "cooldown-ms"=150 {
    "focus-column-right" 
  }
  "Mod+Shift+WheelScrollUp" "cooldown-ms"=150 {
    "focus-column-left" 
  }
  "Mod+T" "hotkey-overlay-title"="Terminal" {
    "spawn" "alacritty"
  }
  "Mod+Up" "hotkey-overlay-title"="Focus Window/Workspace ↑" {
    "focus-window-or-workspace-up" 
  }
  "Mod+V"  {
    "toggle-window-floating" 
  }
  "Mod+W"  {
    "toggle-column-tabbed-display" 
  }
  "Mod+WheelScrollDown" "cooldown-ms"=150 "hotkey-overlay-title"="Focus Window/Workspace ↓" {
    "spawn-sh" "niri-workspace down"
  }
  "Mod+WheelScrollUp" "cooldown-ms"=150 "hotkey-overlay-title"="Focus Window/Workspace ↑" {
    "spawn-sh" "niri-workspace up"
  }
  "XF86AudioLowerVolume" "hotkey-overlay-title"="Vol -" "allow-when-locked"=true {
    "spawn-sh" "noctalia msg volume-down"
  }
  "XF86AudioMicMute" "hotkey-overlay-title"="Mic Mute" "allow-when-locked"=true {
    "spawn-sh" "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
  }
  "XF86AudioMute" "hotkey-overlay-title"="Mute" "allow-when-locked"=true {
    "spawn-sh" "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  }
  "XF86AudioNext" "hotkey-overlay-title"="Playerctl →" "allow-when-locked"=true {
    "spawn-sh" "playerctl next"
  }
  "XF86AudioPlay" "hotkey-overlay-title"="Playerctl play/pause" "allow-when-locked"=true {
    "spawn-sh" "playerctl play-pause"
  }
  "XF86AudioPrev" "hotkey-overlay-title"="Playerctl ←" "allow-when-locked"=true {
    "spawn-sh" "playerctl previous"
  }
  "XF86AudioRaiseVolume" "hotkey-overlay-title"="Vol +" "allow-when-locked"=true {
    "spawn-sh" "noctalia msg volume-up"
  }
  "XF86MonBrightnessDown" "hotkey-overlay-title"="Brightness -" {
    "spawn-sh" "monitor-brightness down"
  }
  "XF86MonBrightnessUp" "hotkey-overlay-title"="Brightness +" {
    "spawn-sh" "monitor-brightness up"
  }
}

"debug"  {
  "force-disable-connectors-on-resume" 
  "wait-for-frame-completion-before-queueing" 
}

"hotkey-overlay"  {
  "skip-at-startup" 
}

"prefer-no-csd" 

"input"  {
  "mouse"  {
    "accel-speed" 1
    "middle-emulation" 
    "scroll-button" 274
    "scroll-factor" 1.3
    "scroll-method" "on-button-down"
  }
  "warp-mouse-to-focus" 
}

"workspace" "gaming" {
  "layout"  {
    "always-center-single-column" 
  }
}
"workspace" "music" {
  "layout"  {
    "default-column-width"  {
      "proportion" 0.8
    }
    "preset-column-widths"  {
      "proportion" 0.8
      "proportion" 0.666667
    }
  }
}

"layout"  {
  "background-color" "transparent"
  "border"  {
    "off" 
  }
  "center-focused-column" "on-overflow"
  "default-column-width"  {
    "proportion" 0.3
  }
  "focus-ring"  {
    "off" 
  }
  "gaps" 12
  "preset-column-widths"  {
    "proportion" 0.3
    "proportion" 0.5
    "proportion" 0.7
  }
  "shadow"  {
    "offset" "x"=0 "y"=8
    "on" 
    "softness" 28
    "spread" 4
  }
  "struts"  {
    "bottom" 0
    "left" 8
    "right" 8
    "top" 0
  }
  "tab-indicator"  {
    "gap" 2
    "hide-when-single-tab" 
    "width" 4
  }
}

"recent-windows"  {
  "binds"  {
    "Alt+Shift+Tab"  {
      "previous-window"  {

      }
    }
    "Alt+Shift+grave"  {
      "previous-window" "filter"="app-id"
    }
    "Alt+Tab"  {
      "next-window" 
    }
    "Alt+grave"  {
      "next-window" "filter"="app-id"
    }
  }
  "highlight"  {
    "corner-radius" 12
    "padding" 30
  }
  "previews"  {
    "max-height" 1080
    "max-scale" 0.75
  }
}

"screenshot-path" "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

include "niri-host.kdl"
include "niri-monitors.kdl"
include optional=true "~/.local/state/nix-theme/niri-colors.kdl"
